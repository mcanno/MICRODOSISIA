# Postgres (Neon). Connection string from the Neon console → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Session cookie signature. Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me"

# Public origin of the site, used for redirects after login
PUBLIC_SITE_URL="http://localhost:4321"

# --- Envío del correo de acceso (magic link) ---
# "log"    (por defecto) no envía nada: en local el enlace se muestra en la
#          propia página. Fuera de localhost se rechaza, para que no se pierdan
#          enlaces en producción sin darse cuenta.
# "resend" envío real vía https://resend.com (requiere las dos claves de abajo).
EMAIL_TRANSPORT="log"
RESEND_API_KEY=""
EMAIL_FROM="MICRODOSISIA <acceso@secot.org>"
