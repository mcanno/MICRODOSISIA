# Postgres (Neon). Connection string from the Neon console → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js. Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me"

# Public origin of the site, used for redirects after login
PUBLIC_SITE_URL="http://localhost:4321"
